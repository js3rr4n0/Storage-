# --- Base de datos (Neon / Postgres) ---
# En Vercel: Storage -> Neon (se crea DATABASE_URL automaticamente).
# Para local, pega aqui tu connection string de Neon.
DATABASE_URL=postgresql://usuario:password@host.neon.tech/neondb?sslmode=require

# --- IA para identificar figuras por foto (Google Gemini, gratis) ---
# Clave gratis (sin tarjeta) en https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: cambiar el modelo de Gemini (por defecto gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
